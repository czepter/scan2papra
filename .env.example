# Pflicht
TRIGGER_TOKEN=
SCANNER_URL=https://<scanner-ip>/eSCL
PAPRA_URL=https://papra.example.de
PAPRA_API_KEY=
PAPRA_ORG_ID=

# Scan-Taste: LAN-IP des Docker-Hosts, Port wie WSD_PORT
WSD_CALLBACK_URL=http://<docker-host-ip>:6666/wsd
# leer = http://<host aus SCANNER_URL>:80/WSD/DEVICE
WSD_TARGET=

# optional
DPI=300
AUTO_COLOR=true
AUTO_CROP=true
PAPRA_TAG_IDS=
UI_PORT=8080
WSD_PORT=6666
AUTO_SCAN=false
LOG_LEVEL=INFO
